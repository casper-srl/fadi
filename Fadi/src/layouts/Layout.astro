---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
  image?: string;
}

const {
  title,
  description = "L'Agenzia Funebre FADI opera a Dasà (VV) dal 1991 offrendo servizi funebri di alta qualità con professionalità e discrezione. Disponibili 24 ore su 24.",
  image = 'https://fadi-lake.vercel.app/og-default.png'
} = Astro.props;
---

<!doctype html>
<html lang="it">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#6b1426" />
    <link rel="icon" type="image/png" href="/favicon-fadi.png" />
    <link rel="apple-touch-icon" href="/icons/pwa-192.png" />
    <link rel="manifest" href="/manifest.webmanifest" />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="it_IT" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url.href} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="400" />
    <meta property="og:image:height" content="400" />
    <!-- Twitter/WhatsApp card -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:image" content={image} />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&family=Lato:wght@300;400;700&display=swap"
      rel="stylesheet"
    />

    <title>{title}</title>

    <style is:global>
      *, *::before, *::after {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      [hidden] {
        display: none !important;
      }

      :root {
        --bg:        #FAF8F5;
        --bg-soft:   #F3EFEA;
        --bg-card:   #ffffff;
        --text:      #2C2620;
        --text-muted:#70665C;
        --gold:      #b8966e;
        --gold-light:#C9AA83;
        --gold-dim:  rgba(184, 150, 110, 0.08);
        --brand-red: #6b1426;
        --brand-red-light: #8b1f35;
        --brand-red-dim: rgba(107, 20, 38, 0.06);
        --brand-red-border: rgba(107, 20, 38, 0.22);
        --border:    rgba(184, 150, 110, 0.22);
        --font-serif:'Playfair Display', Georgia, serif;
        --font-sans: 'Lato', system-ui, sans-serif;
        --radius:    6px;
        --transition:0.3s ease;
      }

      html {
        scroll-behavior: smooth;
      }

      body {
        background-color: var(--bg);
        color: var(--text);
        font-family: var(--font-sans);
        font-size: 1rem;
        line-height: 1.7;
        -webkit-font-smoothing: antialiased;
      }

      h1, h2, h3, h4 {
        font-family: var(--font-serif);
        line-height: 1.25;
        color: var(--text);
      }

      a {
        color: var(--gold);
        text-decoration: none;
        transition: color var(--transition);
      }

      a:hover {
        color: var(--gold-light);
      }

      img {
        max-width: 100%;
        display: block;
      }

      .container {
        width: 100%;
        max-width: 1100px;
        margin: 0 auto;
        padding: 0 1.5rem;
      }

      .section {
        padding: 5rem 0;
      }

      .section-label {
        font-family: var(--font-sans);
        font-size: 0.75rem;
        font-weight: 700;
        letter-spacing: 0.2em;
        text-transform: uppercase;
        color: var(--gold);
        margin-bottom: 0.75rem;
      }

      .section-title {
        font-size: clamp(1.75rem, 4vw, 2.75rem);
        font-weight: 600;
        margin-bottom: 1.25rem;
      }

      .section-text {
        color: var(--text-muted);
        font-size: 1.05rem;
        max-width: 680px;
        line-height: 1.8;
      }

      .divider {
        width: 48px;
        height: 2px;
        background: var(--gold);
        margin: 1.5rem 0;
      }

      .btn {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.8rem 2rem;
        border-radius: var(--radius);
        font-family: var(--font-sans);
        font-size: 0.9rem;
        font-weight: 700;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        transition: all var(--transition);
        cursor: pointer;
        border: none;
      }

      .btn-gold {
        background: var(--gold);
        color: #1a1f2e; /* Original deep navy for sharp and premium gold-foil reading */
      }

      .btn-gold:hover {
        background: var(--gold-light);
        color: #1a1f2e;
        transform: translateY(-1px);
        box-shadow: 0 6px 24px rgba(184, 150, 110, 0.2);
      }

      .btn-outline {
        background: transparent;
        color: var(--gold);
        border: 1px solid var(--gold);
      }

      .btn-outline:hover {
        background: var(--gold-dim);
        color: var(--gold);
        transform: translateY(-1px);
      }

      .card {
        background: var(--bg-card);
        border: 1px solid var(--border);
        border-radius: var(--radius);
        box-shadow: 0 4px 20px rgba(44, 38, 32, 0.02);
        transition: border-color var(--transition), transform var(--transition), box-shadow var(--transition);
      }

      .card:hover {
        border-color: var(--gold);
        transform: translateY(-3px);
        box-shadow: 0 8px 30px rgba(184, 150, 110, 0.1);
      }

      @media (max-width: 768px) {
        .section {
          padding: 3.5rem 0;
        }
      }

      .pwa-global-banner {
        background: #ffffff;
        border-bottom: 1px solid var(--brand-red-border);
      }

      .pwa-global-inner {
        width: 100%;
        max-width: 1100px;
        margin: 0 auto;
        padding: 0.45rem 1.5rem;
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 0.5rem;
      }

      .pwa-install,
      .pwa-notice {
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto;
        align-items: center;
        gap: 0.65rem;
        padding: 0.58rem 0.7rem;
        background: var(--brand-red-dim);
        border: 1px solid var(--brand-red-border);
        border-left: 3px solid var(--brand-red);
        border-radius: var(--radius);
      }

      .pwa-banner-copy {
        display: flex;
        flex-direction: column;
        gap: 0.08rem;
      }

      .pwa-banner-copy strong {
        color: var(--brand-red);
        font-size: 0.78rem;
        font-weight: 700;
        letter-spacing: 0.08em;
        line-height: 1.2;
        text-transform: uppercase;
      }

      .pwa-banner-copy span {
        color: var(--text-muted);
        font-size: 0.78rem;
        line-height: 1.35;
      }

      .pwa-banner-copy span[data-state="success"] {
        color: #25543d;
      }

      .pwa-banner-copy span[data-state="error"] {
        color: #7d1f1f;
      }

      .pwa-install-steps {
        display: block;
      }

      .pwa-banner-btn {
        white-space: nowrap;
        min-height: 2.25rem;
        padding: 0.55rem 0.8rem;
        font-size: 0.72rem;
        letter-spacing: 0.08em;
      }

      .pwa-global-banner .btn-gold {
        background: var(--brand-red);
        color: #ffffff;
      }

      .pwa-global-banner .btn-gold:hover {
        background: var(--brand-red-light);
        color: #ffffff;
        box-shadow: 0 6px 18px rgba(107, 20, 38, 0.16);
      }

      .pwa-global-banner .btn-outline {
        color: var(--brand-red);
        border-color: var(--brand-red);
      }

      .pwa-global-banner .btn-outline:hover {
        background: rgba(107, 20, 38, 0.08);
        color: var(--brand-red);
      }

      @media (max-width: 860px) {
        .pwa-global-inner {
          grid-template-columns: 1fr;
        }
      }

      @media (max-width: 640px) {
        .pwa-global-inner {
          padding: 0.38rem 1rem;
        }

        .pwa-install,
        .pwa-notice {
          grid-template-columns: 1fr;
          gap: 0.5rem;
          padding: 0.52rem 0.6rem;
          text-align: left;
        }

        .pwa-banner-btn {
          width: fit-content;
          justify-content: center;
          padding-inline: 0.65rem;
        }
      }
    </style>
  </head>
  <body>
    <Header />
    <aside class="pwa-global-banner" data-pwa-banner aria-label="App FADI Necrologi">
      <div class="pwa-global-inner">
        <div class="pwa-install" data-pwa-install>
          <div class="pwa-banner-copy">
            <strong>Installa l'app FADI Necrologi</strong>
            <span data-pwa-install-status>Apri gli annunci funebri direttamente dalla schermata principale.</span>
            <span class="pwa-install-steps" data-pwa-install-steps>Dal menu del browser scegli Installa app o Aggiungi alla schermata Home.</span>
          </div>
          <button class="btn btn-outline pwa-banner-btn" type="button" data-pwa-install-button hidden>
            Installa app
          </button>
        </div>

        <div class="pwa-notice" data-pwa-notifications hidden>
          <div class="pwa-banner-copy">
            <strong>Avvisi nuovi necrologi</strong>
            <span data-pwa-notifications-status>Ricevi un avviso quando viene pubblicato un nuovo necrologio.</span>
          </div>
          <button class="btn btn-gold pwa-banner-btn" type="button" data-pwa-notifications-button>
            Attiva notifiche
          </button>
        </div>
      </div>
    </aside>
    <main>
      <slot />
    </main>
    <Footer />
    <script src="/pwa-client.js" defer></script>
  </body>
</html>

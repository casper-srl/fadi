---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
  image?: string;
  hidePwaBanner?: boolean;
}

const {
  title,
  description = "L'Agenzia Funebre FADI opera a Dasà (VV) dal 1991 offrendo servizi funebri di alta qualità con professionalità e discrezione. Disponibili 24 ore su 24.",
  image = 'https://fadi-lake.vercel.app/og-default.png',
  hidePwaBanner = false
} = Astro.props;
---

<!doctype html>
<html lang="it">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#0b0a09" />
    <link rel="icon" type="image/png" href="/favicon-fadi.png" />
    <link rel="apple-touch-icon" href="/icons/pwa-192.png" />
    <link rel="manifest" href="/manifest.webmanifest" />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="it_IT" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url.href} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="400" />
    <meta property="og:image:height" content="400" />
    <!-- Twitter/WhatsApp card -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:image" content={image} />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&family=Lato:wght@300;400;700&display=swap"
      rel="stylesheet"
    />

    <title>{title}</title>

    <style is:global>
      *, *::before, *::after {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      [hidden] {
        display: none !important;
      }

      :root {
        --bg:        #0b0a09;
        --bg-soft:   #12100f;
        --bg-card:   #171412;
        --bg-elevated:#201a17;
        --text:      #f7f1e8;
        --text-muted:#bdb3a7;
        --gold:      #c85f26;
        --gold-light:#e7a05e;
        --gold-dim:  rgba(200, 95, 38, 0.12);
        --copper:    #c85f26;
        --copper-soft:#e7a05e;
        --ivory:     #f7f1e8;
        --brand-red: #8f3d22;
        --brand-red-light: #c85f26;
        --brand-red-dim: rgba(200, 95, 38, 0.08);
        --brand-red-border: rgba(200, 95, 38, 0.28);
        --border:    rgba(200, 95, 38, 0.28);
        --font-serif:'Playfair Display', Georgia, serif;
        --font-sans: 'Lato', system-ui, sans-serif;
        --radius:    8px;
        --transition:0.28s ease;
      }

      html {
        scroll-behavior: smooth;
        overflow-x: hidden;
      }

      body {
        background:
          radial-gradient(circle at 75% -10%, rgba(200, 95, 38, 0.16), transparent 30rem),
          linear-gradient(180deg, #0b0a09 0%, #100e0d 48%, #0b0a09 100%);
        color: var(--text);
        font-family: var(--font-sans);
        font-size: 1rem;
        line-height: 1.7;
        -webkit-font-smoothing: antialiased;
        text-rendering: optimizeLegibility;
        overflow-x: hidden;
      }

      h1, h2, h3, h4 {
        font-family: var(--font-serif);
        line-height: 1.25;
        color: var(--text);
      }

      a {
        color: var(--gold);
        text-decoration: none;
        transition: color var(--transition);
      }

      a:hover {
        color: var(--gold-light);
      }

      ::selection {
        background: rgba(200, 95, 38, 0.38);
        color: #ffffff;
      }

      img {
        max-width: 100%;
        display: block;
      }

      .container {
        width: 100%;
        max-width: 1180px;
        margin: 0 auto;
        padding: 0 1.5rem;
      }

      .section {
        padding: 5.5rem 0;
      }

      .section-label {
        font-family: var(--font-sans);
        font-size: 0.75rem;
        font-weight: 700;
        letter-spacing: 0.2em;
        text-transform: uppercase;
        color: var(--gold);
        margin-bottom: 0.75rem;
      }

      .section-title {
        font-size: clamp(1.75rem, 4vw, 2.75rem);
        font-weight: 600;
        margin-bottom: 1.25rem;
        letter-spacing: 0;
      }

      .section-text {
        color: var(--text-muted);
        font-size: 1.05rem;
        max-width: 680px;
        line-height: 1.8;
      }

      .divider {
        width: 48px;
        height: 1px;
        background: linear-gradient(90deg, var(--gold), transparent);
        margin: 1.5rem 0;
      }

      .btn {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.8rem 2rem;
        border-radius: 999px;
        font-family: var(--font-sans);
        font-size: 0.9rem;
        font-weight: 700;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        transition: color var(--transition), background var(--transition), border-color var(--transition), transform var(--transition), box-shadow var(--transition);
        cursor: pointer;
        border: none;
      }

      .btn-gold {
        background: var(--gold);
        color: #0b0a09;
        border: 1px solid var(--gold);
        box-shadow: 0 12px 34px rgba(200, 95, 38, 0.16);
      }

      .btn-gold:hover {
        background: var(--gold-light);
        color: #0b0a09;
        transform: translateY(-2px);
        box-shadow: 0 16px 42px rgba(200, 95, 38, 0.24);
      }

      .btn-outline {
        background: rgba(255, 255, 255, 0.02);
        color: var(--gold);
        border: 1px solid var(--gold);
      }

      .btn-outline:hover {
        background: var(--gold-dim);
        color: var(--gold);
        transform: translateY(-2px);
      }

      .btn:disabled {
        cursor: wait;
        opacity: 0.72;
        transform: none;
      }

      .card {
        background: var(--bg-card);
        border: 1px solid var(--border);
        border-radius: var(--radius);
        box-shadow: 0 18px 50px rgba(0, 0, 0, 0.2);
        transition: border-color var(--transition), transform var(--transition), box-shadow var(--transition);
      }

      .card:hover {
        border-color: var(--gold);
        transform: translateY(-3px);
        box-shadow: 0 22px 60px rgba(0, 0, 0, 0.34), 0 0 0 1px rgba(200, 95, 38, 0.08);
      }

      .section,
      .card,
      .service-card,
      .srv-card,
      .about-card,
      .image-gallery-item,
      .gallery-item,
      .phone-item-full,
      .email-item,
      .address-card,
      .fioreria-contact-card,
      .fioreria-services {
        animation: fadeLift 0.7s ease both;
      }

      .service-card:nth-child(2),
      .srv-card:nth-child(2n),
      .about-card:nth-child(2),
      .image-gallery-item:nth-child(2n) {
        animation-delay: 0.08s;
      }

      .service-card:nth-child(3),
      .srv-card:nth-child(3n),
      .about-card:nth-child(3),
      .image-gallery-item:nth-child(3n) {
        animation-delay: 0.14s;
      }

      @keyframes fadeLift {
        from {
          opacity: 0;
          transform: translateY(18px);
        }
        to {
          opacity: 1;
          transform: translateY(0);
        }
      }

      @media (prefers-reduced-motion: reduce) {
        *,
        *::before,
        *::after {
          animation-duration: 0.01ms !important;
          animation-iteration-count: 1 !important;
          scroll-behavior: auto !important;
          transition-duration: 0.01ms !important;
        }
      }

      @media (max-width: 768px) {
        .section {
          padding: 3.5rem 0;
        }
      }

      .pwa-global-banner {
        position: relative;
        background: #0f0d0c;
        border-bottom: 1px solid var(--brand-red-border);
      }

      .pwa-global-inner {
        width: 100%;
        max-width: 1100px;
        margin: 0 auto;
        padding: 0.45rem 1.5rem;
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 0.5rem;
      }

      .pwa-dismiss-btn {
        position: absolute;
        top: 0.42rem;
        right: 0.42rem;
        z-index: 2;
        width: 1.65rem;
        height: 1.65rem;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border: 1px solid var(--brand-red);
        border-radius: 50%;
        background: var(--brand-red);
        color: #ffffff;
        cursor: pointer;
        font-size: 1.08rem;
        font-weight: 700;
        line-height: 1;
        transition: background var(--transition), color var(--transition), border-color var(--transition);
      }

      .pwa-dismiss-btn:hover {
        background: var(--brand-red-light);
        border-color: var(--brand-red-light);
        color: #ffffff;
      }

      .pwa-install,
      .pwa-notice {
        position: relative;
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto;
        align-items: center;
        gap: 0.65rem;
        padding: 0.58rem 2.75rem 0.58rem 0.7rem;
        background: rgba(200, 95, 38, 0.08);
        border: 1px solid var(--brand-red-border);
        border-left: 3px solid var(--gold);
        border-radius: var(--radius);
      }

      .pwa-banner-copy {
        display: flex;
        flex-direction: column;
        gap: 0.08rem;
      }

      .pwa-banner-copy strong {
        color: var(--brand-red);
        font-size: 0.78rem;
        font-weight: 700;
        letter-spacing: 0.08em;
        line-height: 1.2;
        text-transform: uppercase;
      }

      .pwa-banner-copy span {
        color: var(--text-muted);
        font-size: 0.78rem;
        line-height: 1.35;
      }

      .pwa-banner-copy span[data-state="success"] {
        color: #25543d;
      }

      .pwa-banner-copy span[data-state="error"] {
        color: #7d1f1f;
      }

      .pwa-install-steps {
        display: block;
      }

      .pwa-banner-btn {
        white-space: nowrap;
        min-height: 2.25rem;
        padding: 0.55rem 0.8rem;
        font-size: 0.72rem;
        letter-spacing: 0.08em;
      }

      .pwa-global-banner .btn-gold {
        background: var(--brand-red);
        color: #ffffff;
      }

      .pwa-global-banner .btn-gold:hover {
        background: var(--brand-red-light);
        color: #ffffff;
        box-shadow: 0 6px 18px rgba(107, 20, 38, 0.16);
      }

      .pwa-global-banner .btn-outline {
        color: var(--brand-red);
        border-color: var(--brand-red);
      }

      .pwa-global-banner .btn-outline:hover {
        background: rgba(107, 20, 38, 0.08);
        color: var(--brand-red);
      }

      @media (max-width: 860px) {
        .pwa-global-inner {
          grid-template-columns: 1fr;
        }
      }

      @media (max-width: 640px) {
        .pwa-global-inner {
          padding: 0.55rem 1rem;
        }

        .pwa-install,
        .pwa-notice {
          grid-template-columns: 1fr;
          gap: 0.5rem;
          padding: 0.62rem 2.7rem 0.62rem 0.6rem;
          text-align: left;
        }

        .pwa-banner-btn {
          width: fit-content;
          justify-content: center;
          padding-inline: 0.65rem;
        }
      }
    </style>
  </head>
  <body>
    <Header />
    {!hidePwaBanner && <aside class="pwa-global-banner" data-pwa-banner data-pwa-dismissible aria-label="App FADI Necrologi">
      <div class="pwa-global-inner">
        <div class="pwa-install" data-pwa-install>
          <button class="pwa-dismiss-btn" type="button" data-pwa-dismiss aria-label="Nascondi questo avviso app per 10 giorni">
            &times;
          </button>
          <div class="pwa-banner-copy">
            <strong>Installa l'app FADI Necrologi</strong>
            <span data-pwa-install-status>Apri gli annunci funebri direttamente dalla schermata principale.</span>
            <span class="pwa-install-steps" data-pwa-install-steps>Dal menu del browser scegli Installa app o Aggiungi alla schermata Home.</span>
          </div>
          <button class="btn btn-outline pwa-banner-btn" type="button" data-pwa-install-button hidden>
            Installa app
          </button>
        </div>

        <div class="pwa-notice" data-pwa-notifications hidden>
          <button class="pwa-dismiss-btn" type="button" data-pwa-dismiss aria-label="Nascondi questo avviso app per 10 giorni">
            &times;
          </button>
          <div class="pwa-banner-copy">
            <strong>Avvisi nuovi necrologi</strong>
            <span data-pwa-notifications-status>Ricevi un avviso quando viene pubblicato un nuovo necrologio.</span>
          </div>
          <button class="btn btn-gold pwa-banner-btn" type="button" data-pwa-notifications-button>
            Attiva notifiche
          </button>
        </div>
      </div>
    </aside>}
    <main>
      <slot />
    </main>
    <Footer />
    <script src="/pwa-client.js" defer></script>
  </body>
</html>

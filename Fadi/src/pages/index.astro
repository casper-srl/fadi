---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import ImageGallery from '../components/ImageGallery.astro';

const serviceGroups = [
  {
    title: 'Servizi funebri',
    items: [
      'Funerali completi',
      'Vestizione e preparazione',
      'Servizi religiosi',
      'Disbrigo pratiche burocratiche',
      'Casse funebri',
      'Prelapidi',
    ],
  },
  {
    title: 'Assistenza e trasporti',
    items: [
      'Reperibilita H24',
      'Trasporti nazionali',
      'Trasporti internazionali',
      'Auto porta fiori',
      'Personale qualificato',
      'Supporto alla famiglia',
    ],
  },
  {
    title: 'Servizi online',
    items: [
      'Annunci funebri',
      'Invio cordoglio',
      'Invio foto ricordo',
      'Fioreria online',
      'Area famiglia',
      'Notifiche app',
    ],
  },
];
---

<Layout
  title="Onoranze Funebri FADI - Dasa (VV) | Dal 1991"
  description="L'Agenzia Funebre FADI opera a Dasa (VV) dal 1991. Servizi funebri completi, fioreria online, necrologi, trasporti nazionali e reperibilita H24."
>
  <Hero />

  <section class="info-intro" id="chi-siamo">
    <div class="container info-intro-grid">
      <div class="intro-kicker">
        <p class="section-label">Info</p>
        <span>Dal 1991</span>
      </div>
      <div class="intro-copy">
        <h2>FADI affianca le famiglie con un servizio completo, discreto e sempre disponibile.</h2>
        <div class="intro-columns">
          <div>
            <h3>Chi siamo</h3>
            <p>
              L'Agenzia Funebre FADI opera a Dasa e in tutta Italia offrendo servizi funebri con
              automezzi propri, personale qualificato e supporto organizzativo in ogni fase.
            </p>
          </div>
          <div>
            <h3>Approccio</h3>
            <p>
              Ogni intervento viene gestito con rispetto, chiarezza e attenzione alle esigenze della
              famiglia, dalla prima chiamata fino alla conclusione della cerimonia.
            </p>
          </div>
          <div>
            <h3>Esperienza</h3>
            <p>
              Oltre trent'anni di attivita, reperibilita continua e servizi digitali rendono piu
              semplice consultare annunci, inviare cordogli e ordinare fiori online.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <ImageGallery label="Galleria" title="La nostra agenzia" />

  <section class="services-editorial" id="servizi-home">
    <div class="container services-editorial-grid">
      <div class="services-heading">
        <p class="section-label">Servizi</p>
        <h2>Una struttura chiara per trovare subito cio che serve.</h2>
        <p>
          La pagina riprende un ritmo piu editoriale: poche cornici, testo ordinato, azioni evidenti
          e liste semplici da scansionare anche da mobile.
        </p>
      </div>

      <div class="service-columns">
        {serviceGroups.map((group) => (
          <section class="service-list" aria-labelledby={`home-${group.title.toLowerCase().replaceAll(' ', '-')}`}>
            <h3 id={`home-${group.title.toLowerCase().replaceAll(' ', '-')}`}>{group.title}</h3>
            <ul>
              {group.items.map((item) => <li>{item}</li>)}
            </ul>
          </section>
        ))}
      </div>
    </div>
  </section>

  <section class="quick-links" aria-label="Percorsi principali">
    <div class="container quick-links-grid">
      <a href="/necrologi/" class="quick-link">
        <span>01</span>
        <strong>Annunci funebri</strong>
        <p>Consulta i necrologi, invia un cordoglio o accedi ai servizi collegati.</p>
      </a>
      <a href="/fioreria" class="quick-link">
        <span>02</span>
        <strong>Fioreria online</strong>
        <p>Ordina un pensiero floreale entrando dalla pagina del defunto.</p>
      </a>
      <a href="/servizi" class="quick-link">
        <span>03</span>
        <strong>Servizi FADI</strong>
        <p>Scopri l'assistenza completa, dai trasporti alle pratiche burocratiche.</p>
      </a>
      <a href="/contatti" class="quick-link">
        <span>04</span>
        <strong>Contatti</strong>
        <p>Chiama FADI in qualsiasi momento o raggiungi la sede a Dasa.</p>
      </a>
    </div>
  </section>

  <section class="contact-editorial" aria-label="Contatti principali">
    <div class="container contact-editorial-grid">
      <div>
        <p class="section-label">Contact</p>
        <h2>Hai bisogno di assistenza immediata?</h2>
      </div>
      <div class="contact-actions">
        <a href="tel:+390963353321">0963 353321</a>
        <a href="tel:+393286731960">328 6731960</a>
        <a href="tel:+393398970915">339 8970915</a>
        <a href="mailto:servizifadi@gmail.com">servizifadi@gmail.com</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .info-intro {
    padding: 6rem 0;
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    background: linear-gradient(180deg, rgba(11, 10, 9, 0.98), rgba(18, 16, 15, 0.98));
  }

  .info-intro-grid,
  .services-editorial-grid,
  .contact-editorial-grid {
    display: grid;
    grid-template-columns: 240px minmax(0, 1fr);
    gap: clamp(2rem, 6vw, 5rem);
    align-items: start;
  }

  .intro-kicker {
    position: sticky;
    top: 120px;
  }

  .intro-kicker span {
    display: block;
    color: var(--text-muted);
    font-family: var(--font-serif);
    font-size: 1.25rem;
  }

  .intro-copy h2,
  .services-heading h2,
  .contact-editorial h2 {
    max-width: 980px;
    color: var(--ivory);
    font-size: clamp(2.3rem, 5vw, 5rem);
    font-weight: 700;
    line-height: 1.04;
  }

  .intro-columns {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 2rem;
    margin-top: 4rem;
  }

  .intro-columns h3,
  .service-list h3 {
    margin-bottom: 0.9rem;
    color: var(--gold);
    font-family: var(--font-sans);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .intro-columns p,
  .services-heading p {
    color: var(--text-muted);
    font-size: 1rem;
    line-height: 1.85;
  }

  .services-editorial {
    padding: 6.5rem 0;
    border-top: 1px solid var(--border);
    background:
      radial-gradient(circle at 80% 12%, rgba(200, 95, 38, 0.14), transparent 24rem),
      var(--bg);
  }

  .services-heading p {
    max-width: 620px;
    margin-top: 1.4rem;
  }

  .service-columns {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1px;
    border: 1px solid var(--border);
    border-radius: 16px;
    overflow: hidden;
    background: var(--border);
  }

  .service-list {
    min-height: 390px;
    padding: 2rem;
    background: rgba(18, 16, 15, 0.98);
  }

  .service-list ul {
    display: grid;
    gap: 0.85rem;
    list-style: none;
  }

  .service-list li {
    display: flex;
    gap: 0.7rem;
    color: var(--text);
    font-size: 1rem;
    line-height: 1.45;
  }

  .service-list li::before {
    content: '';
    width: 0.45rem;
    height: 0.45rem;
    margin-top: 0.55rem;
    border-radius: 50%;
    background: var(--gold);
    flex: 0 0 auto;
  }

  .quick-links {
    padding: 0 0 6.5rem;
    background: var(--bg);
  }

  .quick-links-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    border: 1px solid var(--border);
    border-radius: 18px;
    overflow: hidden;
    background: var(--border);
  }

  .quick-link {
    min-height: 250px;
    padding: 1.8rem;
    background: rgba(247, 241, 232, 0.96);
    color: #16120f;
    text-decoration: none;
    transition: background var(--transition), transform var(--transition);
  }

  .quick-link:hover {
    background: #fff8ed;
    color: #16120f;
    transform: translateY(-4px);
  }

  .quick-link span {
    display: block;
    margin-bottom: 1.9rem;
    color: var(--gold);
    font-family: var(--font-serif);
    font-size: 2rem;
    font-weight: 700;
  }

  .quick-link strong {
    display: block;
    margin-bottom: 0.8rem;
    font-family: var(--font-serif);
    font-size: 1.45rem;
    line-height: 1.15;
  }

  .quick-link p {
    color: #62594f;
    font-size: 0.92rem;
    line-height: 1.6;
  }

  .contact-editorial {
    padding: 6rem 0;
    border-top: 1px solid var(--border);
    background:
      linear-gradient(135deg, rgba(200, 95, 38, 0.18), rgba(11, 10, 9, 0.98) 55%),
      var(--bg-soft);
  }

  .contact-actions {
    display: grid;
    gap: 0.75rem;
  }

  .contact-actions a {
    display: flex;
    align-items: center;
    min-height: 62px;
    padding: 0.8rem 0;
    border-bottom: 1px solid rgba(200, 95, 38, 0.24);
    color: var(--ivory);
    font-family: var(--font-serif);
    font-size: clamp(1.35rem, 3vw, 2.5rem);
    line-height: 1.1;
    text-decoration: none;
  }

  .contact-actions a:hover {
    color: var(--gold-light);
  }

  @media (max-width: 980px) {
    .info-intro-grid,
    .services-editorial-grid,
    .contact-editorial-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .intro-kicker {
      position: static;
    }

    .intro-columns,
    .service-columns,
    .quick-links-grid {
      grid-template-columns: 1fr;
    }

    .service-list,
    .quick-link {
      min-height: auto;
    }
  }
</style>

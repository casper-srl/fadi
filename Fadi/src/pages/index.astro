---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import ImageGallery from '../components/ImageGallery.astro';

const timelineItems = [
  {
    number: '01',
    label: 'Agenzia',
    title: 'Una presenza discreta, vicina alle famiglie dal 1991.',
    text:
      "L'Agenzia Funebre FADI opera a Dasa e in tutta Italia offrendo servizi funebri completi con automezzi propri, personale qualificato e assistenza organizzativa in ogni fase.",
  },
  {
    number: '02',
    label: 'Metodo',
    title: 'Ogni servizio viene seguito con rispetto, chiarezza e attenzione.',
    text:
      'Dalla prima chiamata fino alla conclusione della cerimonia, la famiglia viene accompagnata nelle scelte pratiche e burocratiche con un supporto costante e misurato.',
  },
  {
    number: '03',
    label: 'Disponibilita',
    title: 'Reperibilita continua, giorno e notte, anche nei festivi.',
    text:
      'FADI e disponibile 24 ore su 24 per organizzare il servizio funebre, coordinare i trasporti e gestire le necessita immediate con tempestivita.',
  },
];

const serviceColumns = [
  {
    title: 'Servizi funebri',
    items: ['Funerali completi', 'Vestizione e preparazione', 'Casse funebri', 'Prelapidi', 'Arte funeraria'],
  },
  {
    title: 'Pratiche e trasporti',
    items: [
      'Disbrigo pratiche burocratiche',
      'Trasporti nazionali',
      'Trasporti internazionali',
      'Auto porta fiori',
      'Personale qualificato',
    ],
  },
  {
    title: 'Servizi online',
    items: ['Annunci funebri', 'Invio cordoglio', 'Invio foto ricordo', 'Fioreria online', 'Area famiglia'],
  },
];

const primaryLinks = [
  { href: '/necrologi/', number: '01', title: 'Annunci funebri', text: 'Consulta i necrologi pubblicati e accedi ai servizi collegati.' },
  { href: '/fioreria', number: '02', title: 'Fioreria online', text: 'Ordina un pensiero floreale entrando dalla pagina del defunto.' },
  { href: '/servizi', number: '03', title: 'Servizi FADI', text: "Scopri l'assistenza completa per cerimonie, pratiche e trasporti." },
  { href: '/contatti', number: '04', title: 'Contatti', text: 'Chiama la sede o raggiungi FADI a Dasa.' },
];
---

<Layout
  title="Onoranze Funebri FADI - Dasa (VV) | Dal 1991"
  description="L'Agenzia Funebre FADI opera a Dasa (VV) dal 1991. Servizi funebri completi, fioreria online, necrologi, trasporti nazionali e reperibilita H24."
>
  <Hero />

  <section class="editorial-shell" id="info">
    <div class="container editorial-grid">
      <aside class="editorial-index" aria-label="Indice pagina">
        <p class="section-label">Info</p>
        <nav>
          <a href="#agenzia">Agenzia</a>
          <a href="#servizi">Servizi</a>
          <a href="#percorsi">Percorsi</a>
          <a href="#contatti-home">Contatti</a>
        </nav>
      </aside>

      <div class="editorial-main">
        <header class="editorial-intro" id="agenzia">
          <p class="section-label">Servizi FADI Srl</p>
          <h2>Professionalita, dignita e discrezione al fianco delle famiglie.</h2>
          <p>
            Da oltre trent'anni FADI accompagna le famiglie con un servizio completo,
            organizzato e sempre reperibile. Ogni dettaglio viene seguito con cura, dal
            primo contatto alla cerimonia.
          </p>
        </header>

        <div class="timeline-list">
          {timelineItems.map((item) => (
            <article class="timeline-row">
              <span class="timeline-number">{item.number}</span>
              <div class="timeline-copy">
                <p>{item.label}</p>
                <h3>{item.title}</h3>
                <span>{item.text}</span>
              </div>
            </article>
          ))}
        </div>
      </div>
    </div>
  </section>

  <ImageGallery label="Galleria" title="La nostra agenzia" />

  <section class="service-manifest" id="servizi">
    <div class="container service-grid">
      <div class="service-heading">
        <p class="section-label">Servizi</p>
        <h2>Tutto cio che serve, organizzato in modo chiaro.</h2>
      </div>

      <div class="service-column-grid">
        {serviceColumns.map((column) => (
          <section class="service-column">
            <h3>{column.title}</h3>
            <ul>
              {column.items.map((item) => <li>{item}</li>)}
            </ul>
          </section>
        ))}
      </div>
    </div>
  </section>

  <section class="path-section" id="percorsi" aria-label="Percorsi principali">
    <div class="container">
      <p class="section-label">Percorsi principali</p>
      <div class="path-list">
        {primaryLinks.map((link) => (
          <a href={link.href} class="path-row">
            <span>{link.number}</span>
            <strong>{link.title}</strong>
            <p>{link.text}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="contact-manifest" id="contatti-home" aria-label="Contatti principali">
    <div class="container contact-grid">
      <div>
        <p class="section-label">Contatti</p>
        <h2>Assistenza immediata, 24 ore su 24.</h2>
      </div>
      <div class="contact-links">
        <a href="tel:+390963353321">0963 353321</a>
        <a href="tel:+393286731960">328 6731960</a>
        <a href="tel:+393398970915">339 8970915</a>
        <a href="mailto:servizifadi@gmail.com">servizifadi@gmail.com</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .editorial-shell,
  .service-manifest,
  .path-section,
  .contact-manifest {
    border-top: 1px solid var(--border);
  }

  .editorial-shell {
    padding: clamp(4.5rem, 8vw, 7.5rem) 0;
    background:
      linear-gradient(180deg, rgba(11, 10, 9, 0.98), rgba(18, 16, 15, 0.96)),
      var(--bg);
  }

  .editorial-grid,
  .service-grid,
  .contact-grid {
    display: grid;
    grid-template-columns: minmax(160px, 260px) minmax(0, 1fr);
    gap: clamp(2rem, 7vw, 6rem);
    align-items: start;
  }

  .service-grid,
  .contact-grid {
    grid-template-columns: minmax(320px, 430px) minmax(0, 1fr);
  }

  .editorial-index {
    position: sticky;
    top: 124px;
  }

  .editorial-index nav {
    display: grid;
    gap: 0.7rem;
    margin-top: 1.2rem;
  }

  .editorial-index a {
    width: fit-content;
    color: var(--text-muted);
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .editorial-index a:hover {
    color: var(--gold-light);
  }

  .editorial-intro {
    max-width: 960px;
    padding-bottom: 4rem;
  }

  .editorial-intro h2,
  .service-heading h2,
  .contact-manifest h2 {
    color: var(--ivory);
    font-size: clamp(2.6rem, 6vw, 6.6rem);
    font-weight: 700;
    line-height: 0.98;
    letter-spacing: 0;
  }

  .service-heading h2,
  .contact-manifest h2 {
    font-size: clamp(2.4rem, 4.8vw, 4.9rem);
    line-height: 1;
  }

  .editorial-intro p:not(.section-label) {
    max-width: 660px;
    margin-top: 1.8rem;
    color: var(--text-muted);
    font-size: clamp(1rem, 2vw, 1.18rem);
    line-height: 1.85;
  }

  .timeline-list {
    border-top: 1px solid var(--border);
  }

  .timeline-row {
    display: grid;
    grid-template-columns: 110px minmax(0, 1fr);
    gap: 2rem;
    padding: clamp(2rem, 4vw, 3.3rem) 0;
    border-bottom: 1px solid var(--border);
  }

  .timeline-number {
    color: var(--gold);
    font-family: var(--font-serif);
    font-size: clamp(2.2rem, 5vw, 4rem);
    font-weight: 700;
    line-height: 1;
  }

  .timeline-copy p,
  .service-column h3 {
    margin-bottom: 0.9rem;
    color: var(--gold);
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .timeline-copy h3 {
    max-width: 900px;
    color: var(--ivory);
    font-size: clamp(1.65rem, 3.6vw, 3.6rem);
    font-weight: 700;
    line-height: 1.08;
  }

  .timeline-copy span {
    display: block;
    max-width: 700px;
    margin-top: 1.2rem;
    color: var(--text-muted);
    font-size: 1rem;
    line-height: 1.85;
  }

  .service-manifest {
    padding: clamp(4.5rem, 8vw, 7rem) 0;
    background:
      radial-gradient(circle at 88% 12%, rgba(200, 95, 38, 0.16), transparent 26rem),
      var(--bg);
  }

  .service-column-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1px;
    border: 1px solid var(--border);
    background: var(--border);
  }

  .service-column {
    min-height: 420px;
    padding: clamp(1.6rem, 3vw, 2.4rem);
    background: rgba(18, 16, 15, 0.98);
  }

  .service-column ul {
    display: grid;
    gap: 1rem;
    list-style: none;
  }

  .service-column li {
    color: var(--text);
    font-size: 1rem;
    line-height: 1.45;
  }

  .service-column li::before {
    content: '';
    display: inline-block;
    width: 0.42rem;
    height: 0.42rem;
    margin-right: 0.75rem;
    border-radius: 50%;
    background: var(--gold);
    transform: translateY(-0.08rem);
  }

  .path-section {
    padding: clamp(4rem, 7vw, 6rem) 0;
    background: #f7f1e8;
    color: #15110f;
  }

  .path-section .section-label {
    color: var(--gold);
  }

  .path-list {
    margin-top: 1.5rem;
    border-top: 1px solid rgba(21, 17, 15, 0.2);
  }

  .path-row {
    display: grid;
    grid-template-columns: 90px minmax(220px, 0.7fr) minmax(0, 1fr);
    gap: 2rem;
    align-items: center;
    min-height: 132px;
    padding: 1.4rem 0;
    border-bottom: 1px solid rgba(21, 17, 15, 0.2);
    color: #15110f;
  }

  .path-row:hover {
    color: #15110f;
  }

  .path-row span {
    color: var(--gold);
    font-family: var(--font-serif);
    font-size: 2rem;
    font-weight: 700;
  }

  .path-row strong {
    font-family: var(--font-serif);
    font-size: clamp(1.55rem, 3vw, 2.6rem);
    line-height: 1.08;
  }

  .path-row p {
    color: #665a50;
    font-size: 1rem;
    line-height: 1.65;
  }

  .contact-manifest {
    padding: clamp(4.5rem, 8vw, 7rem) 0;
    background:
      linear-gradient(135deg, rgba(200, 95, 38, 0.18), rgba(11, 10, 9, 0.98) 54%),
      var(--bg-soft);
  }

  .contact-links {
    display: grid;
    gap: 0.15rem;
  }

  .contact-links a {
    display: flex;
    align-items: center;
    min-height: 72px;
    border-bottom: 1px solid rgba(200, 95, 38, 0.26);
    color: var(--ivory);
    font-family: var(--font-serif);
    font-size: clamp(1.45rem, 3.4vw, 3rem);
    line-height: 1.05;
  }

  .contact-links a:hover {
    color: var(--gold-light);
  }

  @media (max-width: 980px) {
    .editorial-grid,
    .service-grid,
    .contact-grid {
      grid-template-columns: 1fr;
      gap: 2.2rem;
    }

    .editorial-index {
      position: static;
    }

    .editorial-index nav {
      display: flex;
      flex-wrap: wrap;
      gap: 1rem;
    }

    .service-column-grid {
      grid-template-columns: 1fr;
    }

    .service-column {
      min-height: auto;
    }

    .path-row {
      grid-template-columns: 70px minmax(0, 1fr);
      gap: 1rem;
    }

    .path-row p {
      grid-column: 2;
    }
  }

  @media (max-width: 640px) {
    .editorial-shell,
    .service-manifest,
    .path-section,
    .contact-manifest {
      padding-block: 3.8rem;
    }

    .timeline-row {
      grid-template-columns: 1fr;
      gap: 1rem;
    }

    .path-row {
      grid-template-columns: 1fr;
      min-height: auto;
    }

    .path-row p {
      grid-column: auto;
    }
  }
</style>

---
import { Image } from 'astro:assets';
import logoImage from '../img/logo-fadi.png';

const navLinks = [
  { href: '/', label: 'Home' },
  { href: '/fioreria', label: 'Fioreria' },
  { href: '/servizi', label: 'Servizi' },
  { href: '/necrologi/', label: 'Annunci Funebri' },
  { href: '/app/', label: 'APP' },
  { href: '/contatti', label: 'Contatti' },
];

const currentPath = Astro.url.pathname;
---

<header class="site-header">
  <div class="container header-inner">

    <!-- Logo / Brand -->
    <a href="/" class="brand" aria-label="Onoranze Funebri FADI — Home">
      <Image src={logoImage} alt="Onoranze Funebri FADI" class="brand-logo" />
    </a>

    <!-- Navigation Desktop -->
    <nav class="nav-desktop" aria-label="Navigazione principale">
      {navLinks.map(link => (
        <a
          href={link.href}
          class={`nav-link ${currentPath === link.href || currentPath === link.href + '/' ? 'active' : ''}`}
        >
          {link.label}
        </a>
      ))}
    </nav>

    <!-- CTA tel -->
    <a href="tel:+390963353321" class="header-tel" aria-label="Chiama FADI">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M6.62 10.79a15.05 15.05 0 0 0 6.59 6.59l2.2-2.2a1 1 0 0 1 1.01-.24c1.12.37 2.33.57 3.58.57a1 1 0 0 1 1 1V20a1 1 0 0 1-1 1C10.61 21 3 13.39 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.46.57 3.58a1 1 0 0 1-.24 1.01l-2.21 2.2z"/>
      </svg>
      0963 353321
    </a>

    <!-- Hamburger mobile -->
    <button class="hamburger" id="hamburger-btn" aria-label="Apri menu" aria-expanded="false" aria-controls="mobile-menu">
      <span></span><span></span><span></span>
    </button>

  </div>

  <!-- Mobile Menu -->
  <nav class="nav-mobile" id="mobile-menu" aria-label="Menu mobile" aria-hidden="true">
    {navLinks.map(link => (
      <a
        href={link.href}
        class="nav-mobile-link"
      >
        {link.label}
      </a>
    ))}
    <a href="tel:+390963353321" class="nav-mobile-tel">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M6.62 10.79a15.05 15.05 0 0 0 6.59 6.59l2.2-2.2a1 1 0 0 1 1.01-.24c1.12.37 2.33.57 3.58.57a1 1 0 0 1 1 1V20a1 1 0 0 1-1 1C10.61 21 3 13.39 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.46.57 3.58a1 1 0 0 1-.24 1.01l-2.21 2.2z" />
      </svg>
      0963 353321
    </a>
  </nav>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(8, 8, 8, 0.88);
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
    border-bottom: 1px solid rgba(200, 95, 38, 0.18);
  }

  .header-inner {
    display: flex;
    align-items: center;
    gap: 2rem;
    height: 92px;
  }

  /* Brand */
  .brand {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    color: var(--text);
    text-decoration: none;
    flex-shrink: 0;
  }

  .brand-logo {
    height: 72px;
    width: auto;
    object-fit: contain;
    display: block;
    filter: drop-shadow(0 10px 24px rgba(0, 0, 0, 0.32));
    transition: transform var(--transition), filter var(--transition);
  }

  .brand:hover .brand-logo {
    transform: scale(1.025);
    filter: drop-shadow(0 14px 28px rgba(200, 95, 38, 0.16));
  }

  .brand-cross {
    font-size: 1.4rem;
    color: var(--gold);
    line-height: 1;
    opacity: 0.9;
  }

  .brand-text {
    display: flex;
    flex-direction: column;
    line-height: 1.1;
  }

  .brand-name {
    font-family: var(--font-serif);
    font-size: 1.35rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: var(--text);
  }

  .brand-sub {
    font-family: var(--font-sans);
    font-size: 0.6rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--gold);
    font-weight: 700;
  }

  /* Nav desktop */
  .nav-desktop {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    margin-left: auto;
  }

  .nav-link {
    font-family: var(--font-sans);
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(247, 241, 232, 0.76);
    padding: 0.55rem 0.9rem;
    border-radius: 999px;
    transition: color var(--transition), background var(--transition), transform var(--transition);
    text-decoration: none;
  }

  .nav-link:hover {
    color: var(--text);
    background: rgba(255, 255, 255, 0.055);
    transform: translateY(-1px);
  }

  .nav-link.active {
    color: var(--gold);
    background: rgba(200, 95, 38, 0.12);
  }

  /* CTA tel */
  .header-tel {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.82rem;
    font-weight: 700;
    color: #0b0a09;
    background: var(--gold);
    padding: 0.62rem 1.1rem;
    border-radius: 999px;
    text-decoration: none;
    white-space: nowrap;
    flex-shrink: 0;
    box-shadow: 0 12px 30px rgba(200, 95, 38, 0.16);
    transition: background var(--transition), transform var(--transition), box-shadow var(--transition);
  }

  .header-tel:hover {
    background: var(--gold-light);
    color: #0b0a09;
    transform: translateY(-2px);
    box-shadow: 0 16px 40px rgba(200, 95, 38, 0.24);
  }

  /* Hamburger */
  .hamburger {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0.5rem;
    margin-left: auto;
  }

  .hamburger span {
    display: block;
    width: 22px;
    height: 2px;
    background: var(--text);
    border-radius: 2px;
    transition: all 0.3s ease;
  }

  /* Mobile menu */
  .nav-mobile {
    display: none;
    flex-direction: column;
    background: rgba(12, 11, 10, 0.98);
    border-top: 1px solid var(--border);
    padding: 1rem 1.5rem 1.5rem;
    gap: 0.25rem;
  }

  .nav-mobile.open {
    display: flex;
  }

  .nav-mobile-link {
    font-size: 0.9rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(247, 241, 232, 0.78);
    padding: 0.75rem 0;
    border-bottom: 1px solid var(--border);
    text-decoration: none;
    transition: color var(--transition);
  }

  .nav-mobile-link:hover {
    color: var(--text);
  }

  .nav-mobile-tel {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    margin-top: 1rem;
    font-size: 1rem;
    font-weight: 700;
    color: var(--gold);
    text-decoration: none;
    padding: 0.5rem 0;
  }

  @media (max-width: 1100px) {
    .header-inner {
      gap: 1rem;
    }

    .nav-link {
      padding-inline: 0.6rem;
      font-size: 0.76rem;
    }
  }

  @media (max-width: 900px) {
    .nav-desktop,
    .header-tel {
      display: none;
    }

    .hamburger {
      display: flex;
    }

    .brand-logo {
      height: 64px;
    }
  }
</style>

<script>
  const btn = document.getElementById('hamburger-btn');
  const menu = document.getElementById('mobile-menu');

  btn?.addEventListener('click', () => {
    const isOpen = menu?.classList.toggle('open');
    btn.setAttribute('aria-expanded', String(isOpen));
    menu?.setAttribute('aria-hidden', String(!isOpen));
  });
</script>

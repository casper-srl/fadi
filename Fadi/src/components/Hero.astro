---
interface Props {
  tagline?: string;
  sub?: string;
}

const {
  tagline = 'Vicini alle famiglie, sempre.',
  sub = 'Professionalita, discrezione e rispetto. Disponibili 24 ore su 24, 365 giorni all\'anno.',
} = Astro.props;
---

<section class="hero" aria-label="Hero principale">
  <div class="hero-ambient" aria-hidden="true"></div>
  <div class="container hero-grid">
    <div class="hero-copy">
      <p class="hero-label">FADI Servizi Funebri</p>
      <h1 class="hero-title">{tagline}</h1>
      <p class="hero-sub">{sub}</p>

      <div class="hero-actions">
        <a href="/necrologi/" class="btn btn-gold" id="hero-cta-annunci">Annunci funebri</a>
        <a href="/fioreria" class="btn btn-outline" id="hero-cta-fioreria">Fioreria online</a>
      </div>

      <div class="hero-contacts" role="list" aria-label="Numeri di telefono">
        <a href="tel:+390963353321" class="hero-contact" role="listitem">
          <span class="hero-contact-dot" aria-hidden="true"></span>
          <span>
            <strong>0963 353321</strong>
            <small>Linea principale</small>
          </span>
        </a>
        <a href="tel:+393286731960" class="hero-contact" role="listitem">
          <span class="hero-contact-dot" aria-hidden="true"></span>
          <span>
            <strong>328 6731960</strong>
            <small>Raffaele</small>
          </span>
        </a>
        <a href="tel:+393398970915" class="hero-contact" role="listitem">
          <span class="hero-contact-dot" aria-hidden="true"></span>
          <span>
            <strong>339 8970915</strong>
            <small>Maria</small>
          </span>
        </a>
      </div>
    </div>

    <div class="hero-visual" aria-hidden="true">
      <div class="hero-photo"></div>
      <div class="hero-panel">
        <p>Cosa serve subito</p>
        <ul>
          <li>Annunci funebri</li>
          <li>Invia dei fiori</li>
          <li>Area famiglia</li>
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: calc(100svh - 92px);
    display: flex;
    align-items: center;
    overflow: hidden;
    background:
      linear-gradient(90deg, rgba(11, 10, 9, 0.98) 0%, rgba(11, 10, 9, 0.94) 46%, rgba(11, 10, 9, 0.64) 100%),
      url('../img/sfondi/fioreria.jpg');
    background-size: cover;
    background-position: center;
  }

  .hero::after {
    content: '';
    position: absolute;
    inset: auto 0 0;
    height: 10rem;
    background: linear-gradient(180deg, transparent, var(--bg));
    pointer-events: none;
  }

  .hero-ambient {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(circle at 72% 24%, rgba(231, 160, 94, 0.18), transparent 18rem),
      radial-gradient(circle at 18% 84%, rgba(200, 95, 38, 0.14), transparent 22rem);
    opacity: 0.9;
    animation: ambientShift 12s ease-in-out infinite alternate;
    pointer-events: none;
  }

  .hero-grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(420px, 0.78fr);
    gap: 4rem;
    align-items: center;
    padding-top: 4.5rem;
    padding-bottom: 5rem;
  }

  .hero-copy {
    max-width: 680px;
    animation: heroCopyIn 0.9s ease both;
  }

  .hero-label {
    margin-bottom: 1.25rem;
    color: var(--gold);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .hero-title {
    max-width: 760px;
    margin: 0;
    color: var(--ivory);
    font-size: clamp(2.45rem, 6vw, 4.6rem);
    font-weight: 700;
    line-height: 1.05;
  }

  .hero-sub {
    max-width: 560px;
    margin-top: 1.6rem;
    color: var(--text-muted);
    font-size: clamp(1rem, 2vw, 1.15rem);
    line-height: 1.75;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
    margin-top: 2rem;
  }

  .hero-contacts {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.8rem;
    margin-top: 2.5rem;
  }

  .hero-contact {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    min-height: 74px;
    padding: 0.9rem;
    border: 1px solid rgba(200, 95, 38, 0.24);
    border-radius: var(--radius);
    background: rgba(255, 255, 255, 0.035);
    color: var(--text);
    text-decoration: none;
    transition: transform var(--transition), border-color var(--transition), background var(--transition);
  }

  .hero-contact:hover {
    transform: translateY(-3px);
    border-color: rgba(200, 95, 38, 0.65);
    background: rgba(200, 95, 38, 0.09);
    color: var(--text);
  }

  .hero-contact-dot {
    width: 0.72rem;
    height: 0.72rem;
    border-radius: 50%;
    background: var(--gold);
    box-shadow: 0 0 0 6px rgba(200, 95, 38, 0.12);
    flex: 0 0 auto;
  }

  .hero-contact strong,
  .hero-contact small {
    display: block;
  }

  .hero-contact strong {
    font-family: var(--font-serif);
    font-size: 1.03rem;
    line-height: 1.1;
  }

  .hero-contact small {
    margin-top: 0.22rem;
    color: var(--text-muted);
    font-size: 0.72rem;
  }

  .hero-visual {
    position: relative;
    min-height: 590px;
    border-left: 1px solid rgba(200, 95, 38, 0.18);
    animation: heroVisualIn 1s ease 0.1s both;
  }

  .hero-photo {
    position: absolute;
    inset: 0 -10vw 0 0;
    border-radius: 18px 0 0 18px;
    background:
      linear-gradient(90deg, rgba(11, 10, 9, 0.24), rgba(11, 10, 9, 0.58)),
      url('../img/sfondi/fioreria.jpg');
    background-size: cover;
    background-position: center;
    box-shadow: inset 0 0 0 1px rgba(200, 95, 38, 0.16), 0 30px 80px rgba(0, 0, 0, 0.36);
    animation: photoDrift 18s ease-in-out infinite alternate;
  }

  .hero-panel {
    position: absolute;
    right: 2rem;
    bottom: 3rem;
    width: min(390px, calc(100% - 4rem));
    padding: 1.6rem 1.8rem;
    border: 1px solid rgba(200, 95, 38, 0.32);
    border-radius: 16px;
    background: rgba(15, 14, 13, 0.84);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.32);
  }

  .hero-panel p {
    margin-bottom: 1rem;
    color: var(--ivory);
    font-family: var(--font-serif);
    font-size: 1.45rem;
    font-weight: 700;
    line-height: 1.2;
  }

  .hero-panel ul {
    list-style: none;
    display: grid;
    gap: 0.65rem;
  }

  .hero-panel li {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    color: var(--text-muted);
    font-size: 0.95rem;
  }

  .hero-panel li::before {
    content: '';
    width: 0.6rem;
    height: 0.6rem;
    border-radius: 50%;
    background: var(--gold);
    flex: 0 0 auto;
  }

  @keyframes heroCopyIn {
    from {
      opacity: 0;
      transform: translateY(22px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes heroVisualIn {
    from {
      opacity: 0;
      transform: translateX(28px);
    }
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  @keyframes photoDrift {
    from {
      transform: scale(1.01) translate3d(0, 0, 0);
    }
    to {
      transform: scale(1.07) translate3d(-1.2rem, -0.8rem, 0);
    }
  }

  @keyframes ambientShift {
    from {
      transform: translate3d(0, 0, 0);
    }
    to {
      transform: translate3d(-1.5rem, 1rem, 0);
    }
  }

  @media (max-width: 980px) {
    .hero {
      min-height: auto;
    }

    .hero-grid {
      grid-template-columns: 1fr;
      gap: 2.5rem;
      padding-top: 3.5rem;
    }

    .hero-visual {
      min-height: 420px;
      border-left: 0;
    }

    .hero-photo {
      inset: 0;
      border-radius: 18px;
    }
  }

  @media (max-width: 720px) {
    .hero-grid {
      padding-top: 3rem;
      padding-bottom: 3.5rem;
      overflow: hidden;
    }

    .hero-copy {
      width: 100%;
      max-width: calc(100vw - 3rem);
      min-width: 0;
    }

    .hero-title {
      max-width: calc(100vw - 3rem);
      font-size: clamp(1.9rem, 9.2vw, 2.35rem);
      overflow-wrap: anywhere;
    }

    .hero-sub {
      max-width: calc(100vw - 3rem);
    }

    .hero-actions {
      width: 100%;
      max-width: calc(100vw - 3rem);
      min-width: 0;
    }

    .hero-actions .btn {
      max-width: 100%;
      padding-inline: 1.2rem;
    }

    .hero-contacts {
      grid-template-columns: 1fr;
    }

    .hero-actions .btn {
      width: 100%;
      justify-content: center;
    }

    .hero-visual {
      min-height: 360px;
    }

    .hero-panel {
      right: 1rem;
      bottom: 1rem;
      width: calc(100% - 2rem);
    }
  }
</style>

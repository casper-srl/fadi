---
interface Props {
  label?: string;
  title?: string;
  soft?: boolean;
}

const {
  label = 'Galleria',
  title = 'La nostra agenzia',
  soft = false,
} = Astro.props;

const images = [
  { src: '/immagini/fadi1.webp', alt: 'Onoranze Funebri FADI' },
  { src: '/immagini/fadi2.webp', alt: 'Servizi funebri FADI' },
  { src: '/immagini/fadi3.webp', alt: 'Agenzia Funebre FADI' },
  { src: '/immagini/fadi4.webp', alt: 'Mezzi e servizi FADI' },
  { src: '/immagini/fadi5.webp', alt: 'FADI Dasa' },
  { src: '/immagini/fadi6.webp', alt: 'Servizi dell agenzia FADI' },
];
---

<section class:list={['section image-gallery-section', { 'image-gallery-section--soft': soft }]}>
  <div class="container">
    <div class="image-gallery-header">
      <p class="section-label">{label}</p>
      <h2 class="section-title">{title}</h2>
      <div class="divider mx-auto"></div>
    </div>

    <div class="image-gallery-grid">
      {images.map((image, index) => (
        <figure class:list={['image-gallery-item', { 'image-gallery-item--wide': index === 0 || index === 3 }]}>
          <img src={image.src} alt={image.alt} loading={index < 2 ? 'eager' : 'lazy'} />
        </figure>
      ))}
    </div>
  </div>
</section>

<style>
  .image-gallery-section {
    background: var(--bg);
    border-top: 1px solid var(--border);
  }

  .image-gallery-section--soft {
    background: var(--bg-soft);
  }

  .image-gallery-header {
    max-width: 720px;
    margin: 0 auto 2.5rem;
    text-align: center;
  }

  .image-gallery-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1rem;
  }

  .image-gallery-item {
    position: relative;
    min-height: 230px;
    margin: 0;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg-card);
    box-shadow: 0 8px 28px rgba(44, 38, 32, 0.06);
  }

  .image-gallery-item--wide {
    grid-column: span 2;
  }

  .image-gallery-item img {
    width: 100%;
    height: 100%;
    min-height: 230px;
    display: block;
    object-fit: cover;
    transition: transform var(--transition);
  }

  .image-gallery-item:hover img {
    transform: scale(1.035);
  }

  @media (max-width: 900px) {
    .image-gallery-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 560px) {
    .image-gallery-grid {
      grid-template-columns: 1fr;
    }

    .image-gallery-item,
    .image-gallery-item--wide {
      grid-column: auto;
    }
  }
</style>
